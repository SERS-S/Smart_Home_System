# CLOUD
REMOTE_USER=root
REMOTE_HOST=127.0.0.1   # your server IP address
REMOTE_PORT=22          # your server SSH port
PASSWORD=your_password  # your server password

# MOSQUITTO
MOSQUITTO_HOST=localhost
MOSQUITTO_PORT=1883
MOSQUITTO_ANONYMOUS_ALLOW=true

# VOICE
REMOTE_VOICE_HOST=localhost
REMOTE_VOICE_PORT=9001

# TELEMETRY
SQLITE_TELEMETRY_DB_PATH=/var/smart_home_system/telemetry.db
SQLITE_API_DB_PATH=/var/smart_home_system/api.db
SQLITE_JOURNAL_DB_PATH=/var/smart_home_system/journal.db
SQLITE_VOICE_DB_PATH=/var/smart_home_system/voice.db
