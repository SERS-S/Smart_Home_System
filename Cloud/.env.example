# CLOUD
REMOTE_USER=root
REMOTE_HOST=127.0.0.1   # your server IP address
REMOTE_PORT=22          # your server SSH port
PASSWORD=your_password  # your server password

# MOSQUITTO
MOSQUITTO_HOST=localhost
MOSQUITTO_PORT=1883
MOSQUITTO_ANONYMOUS_ALLOW=true

# VOICE
REMOTE_VOICE_HOST=localhost
REMOTE_VOICE_PORT=9001

# TELEMETRY
SQLITE_TELEMETRY_DB_PATH=/var/smart_home_system/telemetry.db
SQLITE_API_DB_PATH=/var/smart_home_system/api.db
SQLITE_JOURNAL_DB_PATH=/var/smart_home_system/journal.db
SQLITE_VOICE_DB_PATH=/var/smart_home_system/voice.db

# CONTROL
REMOTE_CONTROL_HOST=127.0.0.1
REMOTE_CONTROL_PORT=7070
CONTROL_MQTT_CLIENT_ID=shs_cloud_control
CONTROL_MQTT_QOS=1
CONTROL_QUEUE_SIZE=128
CONTROL_PUBLISH_TIMEOUT_MS=1500
CONTROL_HTTP_TIMEOUT_SECONDS=10
CONTROL_SHUTDOWN_TIMEOUT_SECONDS=5
CONTROL_MQTT_RECONNECT_SECONDS=2
CONTROL_MQTT_KEEPALIVE_SECONDS=30
CONTROL_LIGHT_DEVICE_ID=light_sensor_01
CONTROL_TEMPERATURE_DEVICE_ID=temperature_sensor_01
CONTROL_MOTOR_DEVICE_ID=motor_01
CONTROL_HAB_DEVICE_ID=hab_01
CONTROL_HAB_RETRY_SECONDS=4
CONTROL_HAB_MAX_ATTEMPTS=45
CONTROL_MOTOR_RETRY_SECONDS=2
CONTROL_MOTOR_MAX_ATTEMPTS=30
CONTROL_HAB_CODEC=PCM
CONTROL_HAB_SAMPLE_FORMAT=s16le
CONTROL_HAB_CHANNELS=1
CONTROL_HAB_SAMPLE_RATE=16000
CONTROL_HAB_FRAGMENT_DURATION_MS=100
CONTROL_HAB_FRAGMENT_SIZE=3200
CONTROL_TOPIC_LIGHT=telemetry/home/light
CONTROL_TOPIC_TEMPERATURE=telemetry/home/temperature
CONTROL_TOPIC_MOTOR=motor/home
CONTROL_TOPIC_HAB=hab/home
CONTROL_TOPIC_VOICE=voice/home/data
CONTROL_TOPIC_JOURNAL=journal/home/info
CONTROL_HISTORY_POINTS=20
CONTROL_JOURNAL_LIMIT=100

# AI-ASSISTANT
IVUS_ENABLED=true
IVUS_SOCKET_PATH=.runtime/ivus.sock
IVUS_MAX_TEXT_RUNES=4096
IVUS_MAX_FRAME_BYTES=65536
IVUS_QUEUE_SIZE=16
IVUS_MAX_CONNECTIONS=4
IVUS_SENSOR_MAX_AGE_SECONDS=600
IVUS_AGENT_TIMEOUT_SECONDS=60
IVUS_GATEWAY_START_TIMEOUT_SECONDS=30
IVUS_SCRIPT_TIMEOUT_SECONDS=15
IVUS_SHUTDOWN_TIMEOUT_SECONDS=5
IVUS_GATEWAY_PORT=18789
IVUS_GATEWAY_TOKEN=REPLACE_WITH_GATEWAY_TOKEN
IVUS_LLM_BASE_URL=REPLACE_WITH_LLM_BASE_URL
IVUS_LLM_MODEL=REPLACE_WITH_MODEL_ID
IVUS_LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
IVUS_LLM_API_STYLE=openai-completions
IVUS_LLM_CONTEXT_WINDOW=0
IVUS_LLM_MAX_OUTPUT_TOKENS=0
IVUS_RATE_LIMIT_PER_MINUTE=30
IVUS_REQUEST_CACHE_ENTRIES=512
IVUS_REQUEST_CACHE_TTL_SECONDS=86400
IVUS_MOSQUITTO_PUB=mosquitto_pub
IVUS_MQTT_USERNAME=
IVUS_MQTT_PASSWORD=
CONTROL_IVUS_ENABLED=true
CONTROL_IVUS_SOCKET_PATH=/usr/local/lib/smart-home/ai-assistant/.runtime/ivus.sock
CONTROL_IVUS_WRITE_TIMEOUT_MS=1000
CONTROL_IVUS_DEDUP_WINDOW_MS=3000
IVUS_INSTALL_DIR=/usr/local/lib/smart-home/ai-assistant
