[Unit]
Description=Smart Home System - Voice recognition
Wants=shs_mosquitto.service
After=network.target shs_mosquitto.service

[Service]
StandardOutput=journal
StandardError=journal
LogNamespace=voice
Type=simple
ExecStart=/usr/local/bin/shs_cloud_voice /usr/local/share/smart-home/models/vosk-model-small-ru-0.22
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
