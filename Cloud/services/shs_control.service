[Unit]
Description=Smart Home System - Control
After=network-online.target shs_mosquitto.service
Wants=network-online.target shs_mosquitto.service

[Service]
StandardOutput=journal
StandardError=journal
LogNamespace=control
Type=simple
ExecStart=/usr/local/bin/shs_cloud_control
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
