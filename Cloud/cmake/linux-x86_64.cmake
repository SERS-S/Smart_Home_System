set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

find_program(ZIG_EXECUTABLE NAMES zig REQUIRED)

set(CMAKE_AR "${ZIG_EXECUTABLE}" CACHE FILEPATH "Zig archiver" FORCE)
set(CMAKE_RANLIB "${ZIG_EXECUTABLE}" CACHE FILEPATH "Zig archive indexer" FORCE)
set(CMAKE_C_ARCHIVE_CREATE "<CMAKE_AR> ar qc <TARGET> <OBJECTS>")
set(CMAKE_C_ARCHIVE_FINISH "<CMAKE_RANLIB> ranlib <TARGET>")
set(CMAKE_CXX_ARCHIVE_CREATE "<CMAKE_AR> ar qc <TARGET> <OBJECTS>")
set(CMAKE_CXX_ARCHIVE_FINISH "<CMAKE_RANLIB> ranlib <TARGET>")

set(CMAKE_C_COMPILER
    "${ZIG_EXECUTABLE}" cc -target x86_64-linux-musl
)

set(CMAKE_CXX_COMPILER
    "${ZIG_EXECUTABLE}" c++ -target x86_64-linux-musl
)

set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
